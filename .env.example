# Copy to .env.local and fill in. .env* is gitignored, so nothing here is committed.
#
# The debrief panel is OPTIONAL and degrades to nothing when this is unset — the
# mission result renders, measures, scores and navigates without it. See
# src/app/api/debrief/route.ts.

# Your OpenRouter key. Server-side only: there is deliberately no NEXT_PUBLIC_
# variant, so this never reaches the browser bundle.
OPENROUTER_API_KEY=

# Model for the AI debrief. Any OpenRouter chat model works.
AI_DEBRIEF_MODEL=google/gemini-2.5-flash
